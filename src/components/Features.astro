---
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const icons = ['/img/icon/icon-08-light.png', '/img/icon/icon-10-light.png', '/img/icon/icon-06-light.png'];
---
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s">
                <h2 class="display-6 mb-5">{d.why.title}</h2>
                <p class="mb-5">{d.why.text}</p>
                {d.why.items.map((item, i) => (
                    <div class:list={['d-flex', i < d.why.items.length - 1 ? 'mb-5' : 'mb-0']}>
                        <div class="flex-shrink-0 btn-square bg-primary rounded-circle" style="width: 90px; height: 90px;">
                            <img class="img-fluid" src={icons[i]} alt="" width="60" height="60">
                        </div>
                        <div class="ms-4">
                            <h3 class="h5 mb-3">{item.title}</h3>
                            <span>{item.text}</span>
                        </div>
                    </div>
                ))}
            </div>
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="position-relative rounded overflow-hidden h-100" style="min-height: 400px;">
                    <img class="position-absolute w-100 h-100" src="/img/feature.jpg" alt={d.why.imgAlt} style="object-fit: cover;" loading="lazy">
                </div>
            </div>
        </div>
    </div>
</div>
