---
import { t, localePath, type Lang } from '../i18n';

const { lang, title } = Astro.props as { lang: Lang; title: string };
const d = t(lang);
---
<div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container text-center py-5">
        <h1 class="display-4 text-white animated slideInDown mb-4">{title}</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href={localePath(lang, 'index')}>{d.nav.index}</a></li>
                <li class="breadcrumb-item active" aria-current="page">{title}</li>
            </ol>
        </nav>
    </div>
</div>
