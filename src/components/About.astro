---
import Icon from './Icon.astro';
import { site, phoneHref, waLink } from '../config';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const pointIcons = ['/img/icon/icon-07-primary.png', '/img/icon/icon-09-primary.png'];
---
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="h-100">
                    <h2 class="display-6 mb-5">{d.about.title}</h2>
                    <div class="row g-4 mb-4">
                        {d.about.points.map((p, i) => (
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center">
                                    <img class="flex-shrink-0 me-3" src={pointIcons[i]} alt="" width="60" height="60">
                                    <h3 class="h5 mb-0">{p}</h3>
                                </div>
                            </div>
                        ))}
                    </div>
                    <p class="mb-4">{d.about.text}</p>
                    <div class="about-cta d-flex flex-wrap gap-3 border-top mt-4 pt-4">
                        <a class="btn btn-primary py-3 px-4" href={phoneHref}><Icon name="phone" class="me-2" />{d.about.call} {site.phone}</a>
                        <a class="btn btn-whatsapp py-3 px-4" href={waLink()} target="_blank" rel="noopener"><Icon name="whatsapp" class="me-2" />{d.about.whatsapp}</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="row g-3">
                    <div class="col-6 text-end">
                        <img class="img-fluid w-75 wow zoomIn" data-wow-delay="0.1s" src="/img/about-1.jpg" width="400" height="400" style="margin-top: 25%;" alt={d.about.imgAlt} loading="lazy">
                    </div>
                    <div class="col-6 text-start">
                        <img class="img-fluid w-100 wow zoomIn" data-wow-delay="0.3s" src="/img/about-2.jpg" width="400" height="400" alt="" loading="lazy">
                    </div>
                    <div class="col-6 text-end">
                        <img class="img-fluid w-50 wow zoomIn" data-wow-delay="0.5s" src="/img/about-3.jpg" width="400" height="400" alt="" loading="lazy">
                    </div>
                    <div class="col-6 text-start">
                        <img class="img-fluid w-75 wow zoomIn" data-wow-delay="0.7s" src="/img/about-4.jpg" width="400" height="400" alt="" loading="lazy">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
