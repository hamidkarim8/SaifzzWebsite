---
import Icon from './Icon.astro';
import { site, waLink } from '../config';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
---
<div class="float-btns">
    {site.tiktok && <a class="float-btn tiktok-float" href={site.tiktok} target="_blank" rel="noopener" aria-label={d.ttFloat}><Icon name="tiktok" /></a>}
    <a class="float-btn whatsapp-float" href={waLink(d.waHello)} target="_blank" rel="noopener" aria-label={d.waFloat}><Icon name="whatsapp" /></a>
</div>
