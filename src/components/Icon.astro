---
import {
  faPhone, faEnvelope, faLocationDot, faClock, faArrowUp, faChevronLeft, faChevronRight, faCheck,
  faTriangleExclamation, faStar, faBolt, faSnowflake, faScrewdriverWrench, faFan, faLightbulb,
  faShieldHalved, faUserCheck, faTags,
} from '@fortawesome/free-solid-svg-icons';
import { faWhatsapp, faTiktok, faFacebookF, faInstagram } from '@fortawesome/free-brands-svg-icons';

const icons = {
  phone: faPhone, envelope: faEnvelope, location: faLocationDot, clock: faClock, 'arrow-up': faArrowUp,
  'chevron-left': faChevronLeft, 'chevron-right': faChevronRight, check: faCheck, warning: faTriangleExclamation,
  star: faStar, bolt: faBolt, snowflake: faSnowflake, tools: faScrewdriverWrench, fan: faFan, bulb: faLightbulb,
  shield: faShieldHalved, 'user-check': faUserCheck, tags: faTags,
  whatsapp: faWhatsapp, tiktok: faTiktok, facebook: faFacebookF, instagram: faInstagram,
};
const { name, class: cls = '' } = Astro.props;
const [w, h, , , d] = icons[name].icon;
---
<svg class={`icon ${cls}`.trim()} viewBox={`0 0 ${w} ${h}`} aria-hidden="true" fill="currentColor"><path d={d} /></svg>
