---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
---
<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center mx-auto wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
            <h2 class="display-6 mb-5">{d.testimonials.title}</h2>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-8 wow fadeIn" data-wow-delay="0.3s">
                <div class="owl-carousel testimonial-carousel">
                    {d.testimonials.items.map((item) => (
                        <figure class="testimonial-item text-center mb-0">
                            <div class="text-primary mb-3">
                                <Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" />
                            </div>
                            <blockquote class="fs-5 mb-4"><p>{item.text}</p></blockquote>
                            <figcaption>
                                <span class="h5 d-block mb-1">{item.name}</span>
                                <span>{item.area}</span>
                            </figcaption>
                        </figure>
                    ))}
                </div>
            </div>
        </div>
    </div>
</div>
