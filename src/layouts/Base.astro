---
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-500.css';
import '@fontsource/roboto/latin-700.css';
import '@fontsource/roboto-slab/latin-400.css';
import '@fontsource/roboto-slab/latin-600.css';
import '@fontsource/roboto-slab/latin-800.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../config';
import { t, localePath, type Lang, type Page } from '../i18n';

const { lang, page } = Astro.props as { lang: Lang; page: Page };
const d = t(lang);
const meta = d.meta[page];
const url = (l: Lang) => new URL(localePath(l, page), Astro.site).href;
const abs = (p: string) => new URL(p, Astro.site).href;
const ogImage = abs('/img/og-image.jpg');
const business = page === 'index' && {
  '@context': 'https://schema.org',
  '@type': ['HVACBusiness', 'Electrician'],
  '@id': `${abs('/')}#business`,
  name: site.name,
  url: url(lang),
  logo: abs('/img/logo.png'),
  image: ogImage,
  description: meta.description,
  telephone: `+${site.whatsapp}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Kajang', addressRegion: 'Selangor', addressCountry: 'MY' },
  areaServed: site.areaServed.map((name) => ({ '@type': 'City', name })),
  sameAs: [site.tiktok, site.facebook, site.instagram].filter(Boolean),
};
---
<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="utf-8">
    <title>{meta.title}</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content={meta.description} name="description">
    {(!site.live || page === '404') && <meta name="robots" content="noindex">}
    {page !== '404' && (
        <Fragment>
            <link rel="canonical" href={url(lang)}>
            <link rel="alternate" hreflang="en" href={url('en')}>
            <link rel="alternate" hreflang="ms" href={url('ms')}>
            <link rel="alternate" hreflang="x-default" href={url('en')}>
            <meta property="og:type" content="website">
            <meta property="og:site_name" content={site.name}>
            <meta property="og:title" content={meta.title}>
            <meta property="og:description" content={meta.description}>
            <meta property="og:url" content={url(lang)}>
            <meta property="og:image" content={ogImage}>
            <meta property="og:image:width" content="1200">
            <meta property="og:image:height" content="630">
            <meta property="og:locale" content={lang === 'en' ? 'en_MY' : 'ms_MY'}>
            <meta name="twitter:card" content="summary_large_image">
        </Fragment>
    )}
    {business && <script type="application/ld+json" set:html={JSON.stringify(business)} />}
    <link href="/favicon-96.png" rel="icon" type="image/png" sizes="96x96">
    <link href="/favicon.ico" rel="icon" sizes="32x32">
    <link href="/apple-touch-icon.png" rel="apple-touch-icon">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#001064">
    <link href="/lib/animate/animate.min.css" rel="stylesheet">
    <link href="/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<Navbar lang={lang} page={page} />
<main>
<slot />
</main>
<Footer lang={lang} />
<WhatsAppButton lang={lang} />
<a href="#" class="btn btn-lg btn-primary btn-lg-square rounded-circle back-to-top" aria-label={d.backToTop}><Icon name="arrow-up" /></a>
<script is:inline src="/lib/jquery/jquery.min.js"></script>
<script is:inline src="/lib/bootstrap/bootstrap.bundle.min.js"></script>
<script is:inline src="/lib/wow/wow.min.js"></script>
<script is:inline src="/lib/easing/easing.min.js"></script>
<script is:inline src="/lib/waypoints/waypoints.min.js"></script>
<script is:inline src="/lib/owlcarousel/owl.carousel.min.js"></script>
<script is:inline src="/lib/counterup/counterup.min.js"></script>
<script is:inline src="/lib/parallax/parallax.min.js"></script>
<script is:inline src="/js/main.js"></script>
{import.meta.env.PROD && <script is:inline>if ('serviceWorker' in navigator) window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));</script>}
</body>
</html>
